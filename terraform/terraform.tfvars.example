# Copy this file to terraform.tfvars and customize the values

# AWS Configuration
aws_region  = "us-west-2"
environment = "dev"
project_name = "healthapp"

# VPC Configuration
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]
availability_zones     = ["us-west-2a", "us-west-2b", "us-west-2c"]

# EKS Cluster Configuration
cluster_name            = "healthapp-eks-cluster"
cluster_version         = "1.35"
node_instance_type      = "t3.medium"
node_group_desired_size = 2
node_group_max_size     = 4
node_group_min_size     = 1
enable_cluster_autoscaler = true
node_ami_type           = "AL2023_x86_64_STANDARD"

# SSH access to nodes (optional). Create the key pair first, then uncomment.
# ssh_key_name      = "healthapp-key"
# ssh_allowed_cidrs = ["10.0.0.0/16"]

# ECR Configuration
ecr_repository_names = [
  "healthapp-frontend",
  "healthapp-master-service",
  "healthapp-register-service",
  "healthapp-document-service"
]
